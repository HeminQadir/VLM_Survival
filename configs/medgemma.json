{
  "backend": "medgemma",
  "model_id": "google/medgemma-1.5-4b-it",
  "model_revision": "main",
  "manifest": "data/synthetic/manifest.csv",
  "output": "runs/medgemma",
  "disease": "liver cancer, subtype not yet specified",
  "features": ["age", "albumin_g_L", "bilirubin_umol_L", "afp_ng_mL", "ecog"],
  "time_edges": [0, 90, 180, 365, 540, 730, 1095],
  "image_mode": "volume",
  "image_shape": [24, 24, 24],
  "feature_dim": 64,
  "visual_tokens": 8,
  "use_image": true,
  "use_tabular": true,
  "epochs": 3,
  "batch_size": 1,
  "accumulation_steps": 8,
  "learning_rate": 0.0001,
  "weight_decay": 0.01,
  "evidence_weight": 0.1,
  "evidence_max_tokens": 128,
  "max_prompt_tokens": 512,
  "lora_rank": 8,
  "lora_alpha": 16,
  "load_in_4bit": false,
  "gradient_checkpointing": true,
  "seed": 17,
  "device": "cuda"
}
